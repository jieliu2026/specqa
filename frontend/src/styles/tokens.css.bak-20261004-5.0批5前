/* ============ 设计 token ============
   灰阶带蓝相（非纯灰）；强调色 3.0 起改丙案墨蓝单一色系；暗色按
   Material 口径基面 #121212 起步、层级靠表面提亮、错误色降饱和提亮。
   批次A2（2026-10-03 视觉 2.0，真源=运营/视觉2.0-20261003/基调稿与组件语言-2.0.md
   第一节）：1.0 既有变量值全部维持不动，只新增——徽标深化色 --ok-ink/--warn-ink、
   证据不足警示面 --ev-*、代码恒深面 --code-*、技术元数据字号 --fs-11、
   动效时长阶 --dur-*、侧栏轨宽 --rail-w（§2.2 布局轨）。 */
:root {
  color-scheme: light;
  /* 灰阶（带蓝相） */
  --g-50:#f7f8fa; --g-100:#eef0f4; --g-200:#e3e6ec; --g-300:#cdd2dc;
  --g-400:#a4abba; --g-500:#737b8c; --g-600:#565e6f; --g-700:#3f4655;
  --g-800:#2a2f3a; --g-900:#1b1f27;
  /* 强调色（5.0 现代极简靛蓝：4.0 信号橙十档整组换血，2026-10-04；
     锚定 #5e6ad2 原值在场于 500 档（品牌气质零损失入族），600 压深
     #515cbd 白字 5.81:1（≥4.5 ✓ 留裕量，反贴线严线 S4≥5.0）；机算
     FAIL 0/WARN 1=机算-5.0十档.py，用途映射冻结=基调-5.0.md §①） */
  --acc-50:#edeef8; --acc-100:#dddff3; --acc-200:#c3c7ea; --acc-300:#9fa6df;
  --acc-400:#7e87d7; --acc-500:#5e6ad2; --acc-600:#515cbd; --acc-700:#3f49a6;
  --acc-800:#353d88; --acc-900:#29306a;
  /* 语义面 */
  --bg:#f7f8fa; --surface:#ffffff; --surface-2:#fbfcfe;
  --ink:#1b1f27; --ink-2:#565e6f;
  --ink-3:#697181; /* 3.0 改值（§1.1 勘误2）：#6b7383→#697181，对 bg 4.49→4.62（4.5 线边缘债清偿） */
  --line:#e3e6ec; --line-strong:#cdd2dc;
  /* 3.0 新增：线制四档（§1.4）——L2 结构粗线/L1.5 中线（字面量独立于灰阶，
     用途穷举：rule-heavy=表格顶底线+masthead 双线粗段；rule-mid=表头 midrule/
     srcs 顶线/hr/blockquote 左线/masthead 双线细段） */
  --rule-heavy:#737b8c; /* 对 bg 4.00（结构线过 3:1 ✓） */
  --rule-mid:#a4abba;   /* 对 bg 2.17（排印冗余档豁免，目标 ≥2 ✓） */
  /* 5.0 派生（亮套，映射公式沿 3.0 丙案同构）：accent=600、hover=700、
     ink=800、tint=50、tink=900、tint-line=200、focus=500
     （=基调-5.0.md §② 终值表；sel-bg/sel-ink 独立对，不取十档） */
  --accent:#515cbd; --accent-hover:#3f49a6; --accent-ink:#353d88;
  --accent-tint:#edeef8; --accent-tink:#29306a; --tint-line:#c3c7ea;
  --ok:#2f9e44; --err:#c92a2a;
  --err-tint:#fdf2f2; --err-line:#f0c9c9;
  --focus:#5e6ad2; --sel-bg:#dfe3f6; --sel-ink:#353d88; /* 5.0：focus=500 锚定原值（对 bg 4.42 ≥3 ✓）、sel 亮 #dfe3f6/#353d88（7.57 ✓，sel-bg 独立值居 50/100 档间） */
  /* 3.0 新增（§1.5）：焦点环复合值收编——四处手抄双环（codebar input/row textarea
     :focus、button:focus-visible、.rail-item-input/.rail-search:focus）T2 统一换
     box-shadow: var(--focus-ring)；引用 --surface/--focus，主题翻转自动跟随 */
  --focus-ring:0 0 0 2px var(--surface), 0 0 0 4px var(--focus);
  /* 2.0 新增：引文徽标深化文本色（对 surface-2 ≈5.2:1，修 1.0 两枚亮色 3.3/3.4:1 债） */
  --ok-ink:#1e7a44; --warn-ink:#8a6508;
  /* 2.0 新增：证据不足（evInsufficient）警示面（3.3 升格警示态用） */
  --ev-tint:#fdf6e9; --ev-line:#e4d5ac;
  /* 2.0 新增：代码块恒深面（3.7 双主题恒深，亮色主题下代码底也为深色） */
  --code-bg:#1c2028; --code-ink:#d6dae4; --code-ink-dim:#98a0b3;
  --code-line:#3a4150; /* 3.0 改值（§1.1/C-4.2）：#323845→#3a4150，对 code-bg 1.39→1.59（装饰豁免档提亮） */
  /* 排版/间距/圆角/网格 */
  --font-sans:-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
    "Helvetica Neue", Arial, "PingFang SC", "HarmonyOS Sans SC", "MiSans",
    "Microsoft YaHei", "Noto Sans CJK SC", "Noto Sans SC", sans-serif;
  --font-mono:ui-monospace, "SF Mono", "Cascadia Code", "Cascadia Mono",
    Menlo, Consolas, "Liberation Mono", monospace;
  /* 5.0 T-a：display 衬线栈 token 整条删除（衬线字体管线退役=ADR-0017
     决策③；W1/W2/W3 白名单穷举制随废，hero 主标题改无衬线 semibold。
     消费面 App.vue/skeleton.css 归 T-b、markdown.css 归 T-c 同批改；
     中间态 var 引用无定义 CSS 不报错） */
  /* --fs-11 仅限技术元数据（代码语言标签/引文徽标/token 徽标），对比预算同 4.5:1，
     不得用于句子级文本（1.3 节） */
  --fs-11:11px; --fs-12:12px; --fs-13:13px; --fs-14:14px; --fs-15:15px; --fs-16:16px; --fs-17:17px; /* --fs-14=5.0 反馈批3 插档（唯一消费面 ≤540 header .name 单行） */
  --fs-20:20px; --fs-24:24px;
  --fs-28:28px; --fs-32:32px; /* 3.0 新增：display 字阶（§1.3b；masthead H1，≤540 断点用 fs-28） */
  --sp-1:4px; --sp-2:8px; --sp-3:12px; --sp-4:16px; --sp-5:24px; --sp-6:32px; --sp-7:48px;
  --r-1:8px; --r-2:12px; --r-3:16px; /* 5.0 材质阶（基调-5.0.md §③）：10/16/24→8/12/16 现代极简收小圆角，消费面零改动（token 涟漪） */
  --col:880px; /* 单一内容列（瑞士网格；5.0 反馈批2 2026-10-04：720→880 正文列加宽，用户桌面反馈「正文太小」校准，登记=差异清单 §十四） */
  --rail-w:264px; /* 2.0 §2.2：侧栏轨宽（≥1024px 常驻 chrome 层，不入内容网格） */
  /* 5.0 T-a：卡片投影档退役删除（基调-5.0.md §③）——卡片件改「细线+浅底」
     两件套（1px line＋浅底零投影；消费面 hero-chip/fu-chip/srcs-it/icp
     归 T-b/T-c 同批改，中间态 var 引用无定义 CSS 不报错） */
  --shadow-pop:0 8px 16px -4px rgb(0 0 0/.10), 0 2px 6px -2px rgb(0 0 0/.06); /* 5.0 微调更平（基调-5.0.md §③）：浮层海拔档，两档不混用纪律沿 4.0（回底浮钮/预览卡/抽屉） */
  /* 2.0 新增：动效时长阶（1.6 节克制面；曲线只用 linear/ease-out，禁 spring） */
  --dur-1:80ms; --dur-2:120ms; --dur-3:200ms;
  /* 5.0 T-a：纸感噪点 token 退役删除（基调-5.0.md §③ 纯净面）——body 规则
     background-image/background-repeat 消费两属性同批去除，背景只留
     background-color（markdown.css th 实底颗粒消费面归 T-c 同批改） */
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg:#121212; --surface:#1e1e1e; --surface-2:#242424;
  --ink:#e9eaee; --ink-2:#aab0bd; --ink-3:#8f95a3;
  --line:#3a3f4a; --line-strong:#414652; /* 3.0 改值（§1.2/C-4.2 灰上灰治理）：#2c2f36→#3a3f4a（对 #1e1e1e 1.24→1.58）、#3b3f49→#414652（对 #121212 1.78→1.98） */
  --rule-heavy:#6e7684; /* 3.0 新增（§1.4）：暗结构粗线，对 #121212 4.09（过 3:1 ✓）；暗线亮度封顶值（宪法四-6） */
  --rule-mid:#4a5060;   /* 3.0 新增：暗中线，对 #121212 2.33（豁免档 ≥2 ✓） */
  /* 5.0 派生（暗套覆写；accent/hover 亮暗同值沿 3.0 §1.7 通则）：
     ink 提亮档 #a9b3f0、tint 深档 #262b47、tink #c3caf5、tint-line #464b7c、
     focus #9099ea（=基调-5.0.md §② 暗套终值列；sel 深底亮字独立对） */
  --accent:#515cbd; --accent-hover:#3f49a6; --accent-ink:#a9b3f0;
  --accent-tint:#262b47; --accent-tink:#c3caf5; --tint-line:#464b7c;
  --ok:#51cf66; --err:#f0838f;
  --err-tint:#3a2226; --err-line:#5c3237;
  --focus:#9099ea; --sel-bg:#2e3256; --sel-ink:#e9eaee; /* 5.0：focus 对 bg 7.07/surface 6.30（≥3 ✓）、sel 暗 #2e3256/#e9eaee（10.23 ✓） */
  /* 2.0 新增（暗套）：徽标文本提亮（对 surface-2 ≈7.6/7.1:1）+证据不足警示面加深 */
  --ok-ink:#6fce8e; --warn-ink:#d9a62e;
  --ev-tint:#33291a; --ev-line:#5c4d2a;
  /* 2.0 新增（暗套）：代码底比基面再压一档（恒深面与基面区分，3.7） */
  --code-bg:#0f1014; --code-ink:#ced3dd; --code-ink-dim:#7d8496; --code-line:#2e3542; /* 3.0 改值：#262a33→#2e3542，对 code-bg 1.32→1.54（豁免档提亮） */
  /* 2.0 新增（暗套）：浮层投影加深（回底浮钮/预览卡/抽屉，1.2 节）；
     5.0 T-a：浮层档微调更平（基调-5.0.md §③）；卡片投影档暗套同批退役删除
     （消费面归 T-b/T-c 改「细线+浅底」两件套）；纸感噪点暗套（白颗粒）同批退役 */
  --shadow-pop:0 8px 16px -4px rgb(0 0 0/.50), 0 2px 6px -2px rgb(0 0 0/.40);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: var(--font-sans); font-size: var(--fs-15); line-height: 1.7;
  background-color: var(--bg); /* 5.0 T-a：噪点消费（background-image/background-repeat）去除，body 背景纯净 */
  color: var(--ink); display: flex; flex-direction: column;
  -webkit-tap-highlight-color: transparent; -webkit-text-size-adjust: 100%;
  font-kerning: normal;
  text-autospace: ideograph-alpha ideograph-numeric;
}
:root[data-theme="dark"] body { -webkit-font-smoothing: antialiased; }
::selection { background: var(--sel-bg); color: var(--sel-ink); }
/* Vue 挂载包裹层：接管 vanilla 里 body 承担的三段式 flex 列容器角色
   （header/main/footer 由 body 直挂改为 #app 直挂）。缺此规则时 #app 为
   block、main 高度不受限 → 滚动容器退化到 document，贴底/回底浮钮全失效。 */
#app { display: flex; flex-direction: column; height: 100%; }
/* 视觉隐藏读屏镜像区（aria-live：流式毕"回答完成"/出错播报；绝不逐 token） */
.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  clip-path: inset(50%);
}
