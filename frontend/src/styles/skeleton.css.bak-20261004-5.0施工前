/* ============================================================
   视觉 3.0 · T5 施工（2026-10-04）：微观与移动打磨
   真源=运营/视觉3.0-20261004/基调稿与组件语言-3.0.md + 九张现状截图
   诊断欠账；拍板=断点三节31。本件改动面：≤540 断点 .icp 徽章带紧凑化
   （§3.12 全维持+移动端精简：双徽章尽量同行、flex-wrap 保底，纯 CSS
   不删元素不改 DOM）+disclaimer 与 icp 间距收紧一档。jump 浮钮 36px
   维持（非高频件+浮钮惯例，登记不扩）。
   ============================================================ */
/* ============ 三段式骨架：全宽横线 + 内容对齐同一 720px 网格 ============ */
header, footer { padding-inline: max(16px, calc((100% - var(--col)) / 2)); }
header {
  background: var(--surface); border-bottom: 1px solid var(--line);
  height: 56px; padding-block: 0; /* 2.0 §2.1：高度显式定 56px（原 padding-block 12px 实况收编为常数） */
  display: flex; align-items: center; gap: 10px;
  position: sticky; top: 0; z-index: 5; flex: none;
}
header .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--g-400); flex: none; position: relative; /* 3.0 §3.14 拍板④：V-1 外环定位上下文 */ }
header .dot[data-state="ok"] { background: var(--ok); }
header .dot[data-state="down"] { background: var(--err); }
/* 3.0 §3.14 拍板④（断点三节31）：V-1 细实线同心外环——10px 点外一圈 1px 细环
   （环心半径 9px、点半径 5px、间隙 3px，对齐素材档 V-1 比例 r8.4/r4.7）；
   ok/down 两态同环（实环，非 V-2 断环）、环/点同色同通道（init 灰档同律）；
   非文本豁免档（§四：色语义由点本体承担，环=形态冗余）；环禁任何动画/旋转
   （素材档 V-1 实现注记明令）。 */
header .dot::after {
  content: ""; position: absolute; inset: -4px; border-radius: 50%;
  border: 1px solid var(--g-400); /* box-sizing border-box（全局规则）：18px 总占位含 1px 环 */
}
header .dot[data-state="ok"]::after { border-color: var(--ok); }
header .dot[data-state="down"]::after { border-color: var(--err); }
header .name { font-weight: 600; font-size: var(--fs-15); letter-spacing: .04em; /* 3.0 §3.14 裁决 #26：.2px→.04em（masthead 字距口径）；字重/字号维持、不入衬线 */ }
header .iconbtn {
  margin-left: auto; width: 32px; height: 32px; border: none; background: none;
  color: var(--ink-2); border-radius: var(--r-1); cursor: pointer;
  display: grid; place-items: center; padding: 0;
}
header .iconbtn svg { width: 18px; height: 18px; }
header .iconbtn .ico-sun { display: none; }
:root[data-theme="dark"] header .iconbtn .ico-sun { display: block; }
:root[data-theme="dark"] header .iconbtn .ico-moon { display: none; }
header .clear {
  border: none; background: none; color: var(--ink-2);
  font-size: var(--fs-13); cursor: pointer; padding: 4px 8px; border-radius: var(--r-1);
}
header .logout {
  border: none; background: none; color: var(--ink-2);
  font-size: var(--fs-13); cursor: pointer; padding: 4px 8px; border-radius: var(--r-1);
}
main {
  flex: 1; overflow-y: auto; padding: 8px max(12px, calc((100% - var(--col)) / 2));
  scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent;
  overscroll-behavior: contain;
}
main::-webkit-scrollbar { width: 8px; }
main::-webkit-scrollbar-thumb { background: var(--line-strong); border-radius: 4px; }
main::-webkit-scrollbar-track { background: transparent; }
main { display: flex; flex-direction: column; }
.thread { max-width: 100%; margin: 0 auto; width: 100%; }
.thread.empty { margin: auto auto; } /* 空状态垂直居中；内容超出时 margin 收零不碍滚动 */

footer {
  background: var(--surface); border-top: 1px solid var(--line);
  padding-block: 10px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
}
.codebar { display: none; gap: 8px; margin-bottom: 8px; }
.codebar.show { display: flex; }
.codebar input {
  flex: 1; border: 1px solid var(--line-strong); border-radius: var(--r-2); padding: 9px 12px;
  font-size: 16px; font-family: inherit; color: var(--ink); background: var(--surface-2); outline: none;
}
.codebar button, .row button.send {
  border: none; background: var(--accent); color: #fff; border-radius: var(--r-2);
  padding: 9px 16px; font-size: var(--fs-13); cursor: pointer; flex: none;
}
.row { display: flex; gap: 10px; align-items: flex-end; }
.row textarea {
  flex: 1; resize: none; border: 1px solid var(--line-strong); border-radius: var(--r-2);
  padding: 10px 12px; font-size: 16px; font-family: inherit; outline: none;
  max-height: 120px; line-height: 1.5; background: var(--surface-2); color: var(--ink);
}
.codebar input::placeholder, .row textarea::placeholder { color: var(--ink-3); opacity: 1; }
.codebar input:focus, .row textarea:focus {
  border-color: var(--focus);
  box-shadow: var(--focus-ring); /* 3.0 §1.5 裁决 #33：复合值收编（值同现双环，行为零变化） */
}
.row button.send { height: 42px; min-width: 64px; }
.row button.send:disabled { opacity: .5; }
.disclaimer { text-align: center; color: var(--ink-3); font-size: var(--fs-12); padding: 6px 0 2px; }
/* 备案信任徽章带（2026-09-26 挂标、09-28 放大为徽章带）：页脚独立视觉带，
   两枚徽章卡（边框+圆角+淡底）横排居中、窄屏竖排；全走既有 token 明暗自适 */
.icp { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 14px;
  margin-top: 8px; padding: 10px 0 2px; border-top: 1px solid var(--line); }
.icp a { display: inline-flex; align-items: center; gap: 7px;
  padding: 8px 16px; border: 1px solid var(--tint-line); border-radius: var(--r-2);
  background: var(--accent-tint); color: var(--accent-tink);
  font-size: var(--fs-15); font-weight: 600; line-height: 1.4; text-decoration: none;
  box-shadow: var(--shadow-card); } /* 方向一（2026-10-04）：备案徽章卡三件套收口（描边+底色已有，投影=T-c 材质批跨文件缺口补落；§4.3 四件穷举之一） */
.icp .icp-icon { display: inline-block; width: 20px; height: 20px; flex: none; color: inherit; }
.icp img.icp-icon { width: 24px; height: 24px; }
/* T5（2026-10-04）：≤540 断点徽章带紧凑形态（九张截图诊断欠账：双备案徽章
   375 纵排两行底部笨重）。降档项：字号 fs-15→fs-12、内边距 8/16→5/10、
   行/列间距 10/14→6/8、图标 20/24→16/18、icp 容器 padding 10/2→8/0、
   徽章高 42→30px；双徽章合计宽 ≈389px，≈421px 以上视口可同行（字体
   度量估算值，原临界 520-560 下移；实机截图验收归后续批次），375-420
   仍两行但每行矮 12px（flex-wrap 保底不删元素不改 DOM）。disclaimer 与
   icp 间距收紧一档：合计 10px（disclaimer 底 2+icp 顶 margin 8）→6px
   （0+6，一档=4px 基数一步；disclaimer 自身顶距不动）。页脚窄屏两行态
   ≈169px（原 ≈207），--jump-b 窄屏兜底值随调（见 message.css）；
   App.vue:796 ResizeObserver 实测覆写为运行时真值。 */
@media (max-width: 540px) {
  .disclaimer { padding: 6px 0 0; }
  .icp { gap: 6px 8px; margin-top: 6px; padding: 8px 0 0; }
  .icp a { padding: 5px 10px; font-size: var(--fs-12); gap: 5px; }
  .icp .icp-icon { width: 16px; height: 16px; }
  .icp img.icp-icon { width: 18px; height: 18px; }
}
/* 回到底部浮钮（贴底滚动纪律：上滑即停跟随、滚回恢复）；
   批0 变量化：--jump-b 默认 167px、窄屏 216px（语义与原两处硬编码等价） */
:root { --jump-b: 167px; }
.jump {
  position: fixed; right: max(16px, calc((100% - var(--col)) / 2));
  bottom: calc(var(--jump-b, 167px) + env(safe-area-inset-bottom)); /* 随页脚实际高度：徽章带单行页脚158px+9px 间隙 */
  width: 36px; height: 36px; border-radius: 50%;
  border: 1px solid var(--line-strong); background: var(--surface);
  color: var(--ink-2); cursor: pointer; display: none; place-items: center;
  box-shadow: var(--shadow-pop); z-index: 6; padding: 0;
} /* 暗色投影走 1.2 节 --shadow-pop 覆写（token 层自动） */
/* 2.0 §3.13：≥1024px 右缘对齐算法随布局轨同步——fixed 百分比基于视口，
   需显式扣除 264px 轨宽后对"剩余空间右缘"取半 */
@media (min-width: 1024px) {
  .jump { right: max(16px, calc((100vw - var(--rail-w) - var(--col)) / 2)); }
}
.jump.show { display: grid; }
.jump svg { width: 16px; height: 16px; }
/* 流式中发送钮变停止：中性描边样式，语义降饱和 */
.row button.send.stop {
  background: var(--surface); color: var(--ink-2); border: 1px solid var(--line-strong);
}
/* 导入询问条（非模态，挂 main 顶部 thread 之上；不抢焦点不阻塞输入与恢复链） */
.import-bar {
  flex: none; width: 100%; margin: 4px 0 12px;
  display: flex; align-items: center; justify-content: space-between;
  gap: 10px; flex-wrap: wrap; padding: 10px 14px;
  border: 1px solid var(--tint-line); border-left: 3px solid var(--accent);
  border-radius: var(--r-1); background: var(--accent-tint);
}
.import-bar-main { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.import-bar-txt { font-size: var(--fs-13); color: var(--accent-ink); line-height: 1.5; }
.import-bar-err { font-size: var(--fs-12); color: var(--ink-2); line-height: 1.4; }
.import-bar-btns { display: flex; gap: 8px; flex: none; }
.import-btn {
  border: 1px solid var(--tint-line); background: var(--surface); color: var(--accent-ink);
  font-size: var(--fs-13); font-family: inherit; border-radius: var(--r-1);
  padding: 5px 12px; cursor: pointer; line-height: 1.4; flex: none;
}
.import-btn.pri { background: var(--accent); color: #fff; border-color: transparent; }
.import-btn:disabled { opacity: .45; cursor: default; }

/* ============================================================
   视觉 4.0 方向一 T-b（2026-10-04）：hero 空状态 IA 重排（左对齐刊头+三内容卡）
   ------------------------------------------------------------
   施工依据=/home/jieliu/qa-bot/运营/视觉4.0-方向1-20261004/基调稿与组件语言-方向1.md
   §二（hero IA 终稿，裁决 #8-#11）+同目录 mock-方向1-v2.html（hero 终态参考实现）；
   DOM 契约=运营/视觉3.0-20261004/T2-DOM契约.md §八（方向一 append 登记面）。
   形态（替代 3.0 T2 居中纵列）：.hero-mast 左对齐刊头（emblem 40px 左置着
   --accent=刊头首屏橙色落点+.hero-mast-main 题文纵列）+rule 72px 左起+三内容
   卡组 .hero-col×3（grid auto-fit：版本对照/热门问答/新规动态；.hero-card.topic
   大卡升 r-3+条目行 mono+发问行动行虚线顶起「→」伪元素箭头，伪元素不入
   textContent=不会填进输入框）。卡片三件套：描边 --line+底 --surface+投影
   var(--shadow-card)（token=方向一 tokens 批供给）。挂点维持 .thread.empty 内
   唯一子容器（垂直居中维持）；W1=衬线白名单消费点维持；点击填入契约不变
   （T2 §三/§八）。
   ≤540 密排（用户 2026-10-04 拍板）：hero-title fs-20（非 3.0 fs-28）+卡组
   密排，验收=375×667 一屏装下刊头+首卡整卡+输入区（mock v2 实测口径 296~472px）。
   ============================================================ */
.hero {
  text-align: left;
  padding: 20px 12px 8px; /* 基调稿 §2.1⑥ 顶距 28px 按 mock v2 空态密度落 20px：生产 hero 仅空态渲染=产品真实首屏口径（登记=T2 §八 8.5） */
  max-width: var(--col);
  margin: 0 auto;
}
.hero-mast { /* 刊头行（方向一增量件，§2.1①）：徽标左置+题文纵列 */
  display: flex; align-items: flex-start; gap: 16px;
}
.hero-mast-main { min-width: 0; }
.hero-emblem { /* 品牌徽标 L-2 印章·Q（currentColor 通道，契约 #2 维持）；方向一着 --accent=刊头首屏橙色落点（亮对 bg 4.49/暗 3.93 ≥3 ✓） */
  color: var(--accent);
  flex: none; margin-top: 5px;
}
.hero-emblem svg {
  display: block; margin: 0;
  width: 40px; height: 40px; /* 方向一 32→40px（基调稿 §2.1①） */
}
.hero-kicker { /* 肩题（§2.1②）：fs-11/.12em/uppercase/ink-3 */
  font-size: var(--fs-11); letter-spacing: .12em; text-transform: uppercase;
  font-weight: 500; color: var(--ink-3); margin-bottom: 10px;
}
.hero-title { /* 主标题：衬线 W1 白名单维持（§2.1③）fs-32/600/1.3；≤540 断点 fs-20 密排（见下，用户拍板） */
  font-family: var(--font-display);
  font-weight: 600; font-size: var(--fs-32); line-height: 1.3;
  color: var(--ink); margin-bottom: 16px;
}
.hero-rule { /* 粗细线对（§2.1④）：72px 左起挂号（3.0 居中改左起）；全站唯一双线落点维持（§1.4） */
  width: 72px; margin: 0 0 16px;
  border-top: 2px solid var(--rule-heavy); /* 上粗线 L2 */
  position: relative;
}
.hero-rule::after { /* 下细线 L1.5：2px 粗线+间距 3px+1px 中线（top 5px=2+3 维持） */
  content: ""; position: absolute; left: 0; right: 0; top: 5px;
  border-top: 1px solid var(--rule-mid);
}
.hero-sub { /* 副题（§2.1⑤）：fs-15/ink-2/sans（默认栈零声明） */
  font-size: var(--fs-15); color: var(--ink-2); margin-bottom: 26px;
}
.hero-cards { /* 三内容卡组（§2.2）：grid auto-fit 三栏、窄屏自动并栈（~351px 内容宽下单列纵排，无新断点规则） */
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(208px, 1fr));
  gap: 12px;
}
.hero-col { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.hero-col-k { /* 栏目签（§2.2）：肩题制+accent-ink（橙色落点之二；亮 7.66/暗 9.18 ✓） */
  font-size: var(--fs-11); letter-spacing: .12em; text-transform: uppercase;
  font-weight: 600; color: var(--accent-ink); margin-bottom: 2px;
}
.hero-card { /* 内容卡：卡片三件套=描边+底色+投影（方向一 §4.3 穷举四件之一） */
  display: flex; align-items: center; gap: 12px; text-align: left;
  border: 1px solid var(--line); border-radius: var(--r-2); background: var(--surface);
  box-shadow: var(--shadow-card);
  padding: 10px 14px; cursor: pointer; font-family: inherit;
}
.hero-card:active { background: var(--surface-2); } /* active 底 surface-2（维持） */
.hero-card-num { /* 圆序标（契约 #9 维持）：28px 细圆框+mono 数字，框/数字同色同通道（V-1 环同律） */
  flex: none; display: inline-grid; place-items: center;
  width: 28px; height: 28px; border: 1px solid var(--ink-3); border-radius: 50%;
  font-family: var(--font-mono); font-size: var(--fs-12);
  font-variant-numeric: tabular-nums; color: var(--ink-3);
}
.hero-card-txt { /* 问题字串/发问行动行：sans fs-15/ink-2（不入衬线）；点击填入输入框（T2 §三/§八契约不变） */
  font-size: var(--fs-15); color: var(--ink-2); line-height: 1.6;
}
.hero-card.topic { /* 协议域主题大卡（§2.2）：条目纵排+发问行动行，圆角升 r-3（§4.3） */
  flex: 1; flex-direction: column; align-items: flex-start; gap: 10px;
  border-radius: var(--r-3); padding: 14px 16px;
}
.hero-card-body { display: flex; flex-direction: column; gap: 5px; width: 100%; }
.hero-card-row { /* 条目行（§2.2）：mono 技术身份（对齐出处药丸字体制）；条目=真实 SRCS 版本/条款串静态化（mock v2 原样） */
  font-family: var(--font-mono); font-size: var(--fs-12); line-height: 1.5;
  color: var(--ink-2); font-variant-numeric: tabular-nums; overflow-wrap: anywhere;
}
.hero-card.topic .hero-card-txt { /* 发问行动行（§2.2）：虚线分隔顶起；整卡点击=此句填入输入框 */
  width: 100%; padding-top: 8px; margin-top: 2px;
  border-top: 1px dashed var(--line);
  color: var(--ink); font-weight: 500;
}
.hero-card.topic .hero-card-txt::before { /* 行动箭头（伪元素不入 textContent=不会填进输入框） */
  content: "→ "; color: var(--accent); font-weight: 700;
}
@media (hover: hover) { /* 桌面 hover（§2.2 沿 chip 交互语言）：描边转 --focus、字转 accent-ink；
   动效允许清单穷举制不扩=瞬时切换零转场（维持 3.0 口径） */
  .hero-card:hover { border-color: var(--focus); }
  .hero-card:hover .hero-card-txt { color: var(--accent-ink); }
}
@media (max-width: 540px) {
  /* ≤540 空态密排（用户 2026-10-04 拍板，mock v2 实测口径）：title fs-20（非
     3.0 fs-28）+间距/卡组密排——保「刊头+卡组首行+输入区」同进 375×667 首屏
     （首卡=版本对照 topic 卡实测 296~472px）；字串零改动，仅排版密度档。 */
  .hero { padding-top: 8px; }
  .hero-mast { gap: 12px; }
  .hero-emblem { margin-top: 2px; }
  .hero-emblem svg { width: 34px; height: 34px; }
  .hero-kicker { margin-bottom: 8px; }
  .hero-title { font-size: var(--fs-20); line-height: 1.3; margin-bottom: 12px; }
  .hero-rule { margin-bottom: 12px; }
  .hero-sub { margin-bottom: 12px; }
  .hero-cards { gap: 10px; }
  .hero-col { gap: 6px; }
  .hero-card.topic { padding: 11px 14px; gap: 8px; }
  .hero-card-body { gap: 4px; }
  .hero-card.topic .hero-card-txt { padding-top: 6px; }
}
